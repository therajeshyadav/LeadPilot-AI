# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
PUBLIC_API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leadpilot?schema=public

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Voice provider (Vapi is the initial production provider)
VOICE_PROVIDER=vapi
VOICE_API_KEY=
VOICE_AGENT_ID=
VOICE_WEBHOOK_SECRET=

# Twilio calling and WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WEBHOOK_AUTH_TOKEN=

# Calling / contact configuration (E.164 format)
TARGET_PHONE_NUMBER=
SALES_CONTACT_PHONE=

# Google Calendar (optional; callbacks remain in PostgreSQL when omitted)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Callback defaults
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CALLBACK_MORNING_HOUR=10
DEFAULT_CALLBACK_AFTERNOON_HOUR=15
DEFAULT_CALLBACK_EVENING_HOUR=18

# Optional public attachments for post-call WhatsApp media messages
ARCHITECTURE_IMAGE_URL=
RESUME_DOCUMENT_URL=
