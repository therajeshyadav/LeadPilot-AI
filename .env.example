# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
PUBLIC_API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leadpilot?schema=public

# OpenAI (paid)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# Gemini (FREE - 1500 requests/day!) Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Voice provider (Vapi is the initial production provider)
VOICE_PROVIDER=vapi
VOICE_API_KEY=your_vapi_api_key_here
VOICE_AGENT_ID=your_vapi_agent_id_here
VOICE_WEBHOOK_SECRET=your_vapi_webhook_secret_here

# Twilio calling and WhatsApp
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WEBHOOK_AUTH_TOKEN=your_twilio_webhook_auth_token_here

# Calling / contact configuration (E.164 format)
TARGET_PHONE_NUMBER=+1234567890
SALES_CONTACT_PHONE=

# Google Calendar (optional; callbacks remain in PostgreSQL when omitted)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:4000/oauth/callback
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here
GOOGLE_CALENDAR_ID=primary

# Callback defaults
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CALLBACK_MORNING_HOUR=10
DEFAULT_CALLBACK_AFTERNOON_HOUR=15
DEFAULT_CALLBACK_EVENING_HOUR=18

# Optional public attachments for post-call WhatsApp media messages
ARCHITECTURE_IMAGE_URL=
RESUME_DOCUMENT_URL=
